#Rule to detect RDP X.224 Connetion request
# 03 00 = TPKT header (used by RDP)
# E0 = X.224 Connection Request PDU type
# Using this rule help minimize false alerts on port 3389 

alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"RDP X.224 Connection Request";flow:established;content:"|03 00|";depth:2;content:"|E0|";distance:3;within:1;classtype:attempted-admin;priority:1;sid:1000002;rev:1;)
