# This rule is to detect all internal RDP connection based on the mstshash cookie. 
# if home_net is not configured then this wont work

alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:" RDP Cookie Detected";flow:established;content:"Cookie: mstshash=";nocase;classtype:attempted-admin;priority:1;sid:1000002;rev:2;)
